{
  "name": "kruz",
  "version": "1.7.1",
  "description": "Headed browser automation MCP server for AI agents - verification-first clicking, semantic targeting, recovery ladders, and ATS job harvesting.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "kruz": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "mcp",
    "browser-automation",
    "puppeteer",
    "ats",
    "job-finder",
    "ai-agents",
    "shadow-dom",
    "cdp"
  ],
  "author": "Kruz Contributors",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {

    "@modelcontextprotocol/sdk": "^1.0.0",
    "puppeteer-core": "^23.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.5.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}
