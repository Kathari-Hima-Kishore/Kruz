# Build output
dist/
# NOTE: a .gitignore must never list itself. A previous commit did, which
# untracked the file and would have dropped it from a fresh clone.
# Dependencies
node_modules/

# Runtime browser state (regenerable; holds cookies/logins for the persistent profile)
browser-profile/
downloads/

# Local env
.env
.env.local
config.local.json

# GENERATED by `npm run build` (scripts/write-opencode-config.mjs).
# Machine-specific by construction: it embeds the absolute node path and the
# absolute install dir of whichever machine ran the build. Committing it would
# hand every other checkout another developer's paths — the exact hardcoded-path
# failure this setup exists to remove. Re-running `npm run build` regenerates it
# correctly for whoever clones.
opencode.json
opencode.jsonc
.opencode/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs & temp
*.log
npm-debug.log*
qa/
*.tsbuildinfo

# Scratch dump — screenshots for image analysis, verification captures, scratch
# harnesses. Created on demand and deleted by hand; nothing here is source.
# The contents are ignored but the README is kept, so the convention survives a
# fresh clone.
dump/*
!dump/README.md
